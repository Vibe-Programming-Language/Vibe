// ── Vibe Language Feature Showcase ──
// Demonstrates: variables, control flow, functions, classes, lists, maps, match

// ── Variables & Types ──
var name = "Vibe";
const VERSION = "1.0.0";
var score = 100;
var pi = 3.14159;
var active = true;

print("=== Vibe " + VERSION + " Feature Showcase ===");
print("");

// ── Arithmetic & Operators ──
print("── Arithmetic ──");
print("10 + 3 = " + str(10 + 3));
print("10 - 3 = " + str(10 - 3));
print("10 * 3 = " + str(10 * 3));
print("10 / 3 = " + str(10 / 3));
print("10 ~/ 3 = " + str(10 ~/ 3));
print("10 % 3 = " + str(10 % 3));
print("2 ** 10 = " + str(2 ** 10));
print("");

// ── Strings ──
print("── Strings ──");
var greeting = "Hello, World!";
print("upper: " + greeting.upper());
print("lower: " + greeting.lower());
print("contains 'World': " + str(greeting.contains("World")));
print("slice(0,5): " + greeting.slice(0, 5));
print("split: " + str(greeting.split(", ")));
print("repeat: " + "ha".repeat(3));
print("");

// ── Lists ──
print("── Lists ──");
var nums = [5, 2, 8, 1, 9, 3];
print("Original: " + str(nums));
nums.sort();
print("Sorted:   " + str(nums));
nums.reverse();
print("Reversed: " + str(nums));
nums.push(42);
print("Pushed 42: " + str(nums));
print("Length: " + str(nums.length()));
print("Contains 8: " + str(nums.contains(8)));

var doubled = nums.map((n) => n * 2);
print("Doubled: " + str(doubled));

var big = nums.filter((n) => n > 5);
print("Filter > 5: " + str(big));
print("");

// ── Maps ──
print("── Maps ──");
var scores = {"Alice": 95, "Bob": 88, "Carol": 72};
print("Alice: " + str(scores.get("Alice")));
scores.set("Dave", 91);
print("Keys: " + str(scores.keys()));
print("Has Bob: " + str(scores.has("Bob")));
print("");

// ── Control Flow ──
print("── Control Flow ──");
var grade = score >= 90 ? "A" : score >= 80 ? "B" : "C";
print("Score " + str(score) + " → Grade " + grade);

// ── Match ──
print("── Match ──");
var day = "Friday";
match day {
    "Monday"  -> print("  Start of week");
    "Friday"  -> print("  TGIF!");
    "Sunday"  -> print("  Rest day");
    _         -> print("  Regular day");
}
print("");

// ── Loops ──
print("── Loops ──");
var fib_seq = [0, 1];
for var i in range(2, 12) {
    var next = fib_seq[i - 1] + fib_seq[i - 2];
    fib_seq.push(next);
}
print("Fibonacci: " + str(fib_seq));
print("");

// ── Functions ──
print("── Functions ──");
fn factorial(n) {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}

fn isPrime(n) {
    if (n < 2) { return false; }
    for var i in range(2, n) {
        if (n % i == 0) { return false; }
    }
    return true;
}

print("5! = " + str(factorial(5)));
print("10! = " + str(factorial(10)));

var primes = [];
for var i in range(2, 30) {
    if (isPrime(i)) {
        primes.push(i);
    }
}
print("Primes < 30: " + str(primes));
print("");

// ── Classes ──
print("── Classes ──");

class Vector {
    var x;
    var y;

    init(x, y) {
        self.x = x;
        self.y = y;
    }

    fn magnitude() {
        return (self.x ** 2 + self.y ** 2) ** 0.5;
    }

    fn add(other) {
        return new Vector(self.x + other.x, self.y + other.y);
    }

    fn toString() {
        return "(" + str(self.x) + ", " + str(self.y) + ")";
    }
}

var v1 = new Vector(3, 4);
var v2 = new Vector(1, 2);
var v3 = v1.add(v2);

print("v1 = " + v1.toString());
print("v2 = " + v2.toString());
print("v1 + v2 = " + v3.toString());
print("|v1| = " + str(v1.magnitude()));
print("");

// ── Inheritance ──
class Shape {
    var name;
    init(name) { self.name = name; }
    fn area() { return 0; }
    fn describe() {
        return self.name + " with area " + str(self.area());
    }
}

class Rectangle extends Shape {
    var w;
    var h;
    init(w, h) {
        super("Rectangle");
        self.w = w;
        self.h = h;
    }
    override fn area() {
        return self.w * self.h;
    }
}

class Circle extends Shape {
    var r;
    init(r) {
        super("Circle");
        self.r = r;
    }
    override fn area() {
        return 3.14159 * self.r * self.r;
    }
}

var shapes = [new Rectangle(5, 3), new Circle(4)];
for var s in shapes {
    print("  " + s.describe());
}
print("");

// ── Error Handling ──
print("── Error Handling ──");
fn safeDivide(a, b) {
    if (b == 0) {
        throw "Division by zero!";
    }
    return a / b;
}

try {
    print("  10 / 3 = " + str(safeDivide(10, 3)));
    print("  10 / 0 = " + str(safeDivide(10, 0)));
} catch (e) {
    print("  Caught: " + str(e));
}
print("");

print("=== All features working! ===");
